// Dock.slint — Bottom-centre floating dock, macOS-style.
// Visual: squircle-approximated (20 px border-radius) container whose colour
// animates between dark (#b5000000) and light (rgba(240,240,240,0.80)) via
// locally-resolved properties that watch Theme.mode.
// Icons: 48 px squares, hover scale 1.0→1.15 (animate), active dot below running apps.
//
// Animation strategy:
//   Locally-resolved colour properties in the Dock pill carry 200 ms
//   ease-in-out animate blocks.  The DockIconSlot carries animate blocks on its
//   running-dot colour so it crossfades independently.

import { Tokens, Theme, TokenMode } from "./Tokens.slint";

// ── Data type shared with Rust ────────────────────────────────────────────────
export struct DockItem {
    icon:    image,
    app-id:  string,
    /// Display name (resolved from .desktop) — shown as a tooltip on hover.
    name:    string,
    running: bool,
    focused: bool,
    pinned:  bool,
}

// ── Internal single icon slot ─────────────────────────────────────────────────
//
// Each app icon sits inside its own dark squircle "button" container — a
// rounded-rect with a subtle dark fill + thin top-edge highlight, separate
// from the dock pill itself. Mirrors the screenshot the user shared.
component DockIconSlot {
    in property <DockItem> item;
    in property <bool>     show-separator: false;

    callback icon-clicked(string);
    /// Right-click on the icon. Args: app-id, cursor x/y in slot-local space
    /// (caller can convert to compositor-space for context-menu positioning).
    callback icon-right-clicked(string, length, length);

    // Slot is sized to give icons a generous footprint with minimal
    // padding — macOS-style: icons fill ~80% of the slot, no border /
    // background by default, only a faint hover highlight.
    width: 64px;
    height: 68px;

    // ── Subtle hover background (animated). No idle bg, no border, no
    //    top-edge gloss — the icon itself is the visual; we keep things
    //    quiet until the cursor actually hovers a slot.
    property <color> button-bg-hover: Theme.mode == TokenMode.Dark
        ? rgba(255, 255, 255, 0.10)
        : rgba(0, 0, 0, 0.06);
    property <color> button-bg-pressed: Theme.mode == TokenMode.Dark
        ? rgba(255, 255, 255, 0.18)
        : rgba(0, 0, 0, 0.10);

    animate button-bg-hover   { duration: 180ms; easing: ease-in-out; }
    animate button-bg-pressed { duration: 180ms; easing: ease-in-out; }

    // Running-dot colours (locally-resolved for animation).
    property <color> dot-color: item.focused
        ? Theme.dock-dot-focused
        : Theme.dock-dot-running;
    animate dot-color { duration: 200ms; easing: ease-in-out; }

    // Touch area covers the full slot.
    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        pointer-event(e) => {
            if (e.button == PointerEventButton.right
                && e.kind == PointerEventKind.up) {
                root.icon-right-clicked(root.item.app-id, self.mouse-x, self.mouse-y);
            }
        }
        clicked => { root.icon-clicked(root.item.app-id); }
    }

    // ── Hover spotlight (only visible on hover/press) ───────────────────
    // No fill / border at rest — the icon is the entire visual.
    button := Rectangle {
        property <length> button-size: 60px;
        x: (parent.width - self.width) / 2;
        y: 4px - (ta.has-hover ? 4px : 0px);
        width: button-size;
        height: button-size;
        border-radius: 14px;
        background: ta.pressed
            ? root.button-bg-pressed
            : (ta.has-hover ? root.button-bg-hover : transparent);
        animate background { duration: 140ms; easing: ease-out; }
        animate y          { duration: 200ms; easing: ease-out; }

        // Icon image — fills almost the whole slot for a chunky, macOS-
        // style appearance. 4 px inset leaves a tiny breathing margin.
        icon-img := Image {
            x: 4px;
            y: 4px;
            width:  parent.width - 8px;
            height: parent.height - 8px;
            source: root.item.icon;
            image-fit: contain;
        }
    }

    // ── Tooltip — macOS-style, shows the app's display name on hover ──
    // Re-positioned to render INSIDE the slot but ABOVE the pill region
    // (we render it from a Layer outside the pill in DockSlot). Negative
    // y combined with `clip: false` on the slot lets it escape the dock
    // pill's clip. Sits above the button, fading in 100 ms after enter.
    if ta.has-hover && root.item.name != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: -self.height - 4px - (ta.has-hover ? 3px : 0px);
        width: tip-text.preferred-width + 14px;
        height: 22px;
        background: Theme.mode == TokenMode.Dark
            ? rgba(20, 22, 28, 0.96)
            : rgba(36, 38, 46, 0.95);
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.mode == TokenMode.Dark
            ? rgba(255, 255, 255, 0.10)
            : rgba(0, 0, 0, 0.18);
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: rgba(0, 0, 0, 0.45);
        tip-text := Text {
            x: 7px; y: 0;
            width: parent.width - 14px;
            height: parent.height;
            text: root.item.name;
            color: rgba(255, 255, 255, 0.92);
            font-family: Tokens.font-family;
            font-size: 12px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }

    // Active indicator — centred below the button for running apps.
    // macOS-style: a small pill (5×3) instead of a tight dot — focused
    // window gets a wider 8 px pill so the user can spot the active one
    // at a glance.
    if item.running: dot := Rectangle {
        property <length> w-pill: item.focused ? 8px : 5px;
        x: (parent.width - w-pill) / 2;
        y: parent.height - 6px;
        width: w-pill;
        height: 3px;
        border-radius: 1.5px;
        background: root.dot-color;
        animate width      { duration: 200ms; easing: ease-in-out; }
        animate background { duration: 200ms; easing: ease-in-out; }
    }
}

// ── Separator between pinned and running sections ─────────────────────────────
component DockSeparator {
    // Separator colour mirrors dock-border (animated on theme change).
    property <color> sep-color: Theme.dock-border;
    animate sep-color { duration: 200ms; easing: ease-in-out; }

    width: 18px;
    height: 64px;

    Rectangle {
        x: (parent.width - 1px) / 2;
        y: (parent.height - 32px) / 2;
        width: 1px;
        height: 32px;
        background: root.sep-color;
    }
}

// ── Public Dock component ─────────────────────────────────────────────────────
export component Dock {
    in property <[DockItem]> items;
    in property <image>      backdrop;
    in property <length>     backdrop-screen-w: 1px;
    in property <length>     backdrop-screen-h: 1px;
    in property <length>     backdrop-offset-y: 0px;
    callback icon-clicked(string);
    /// Right-click — caller positions a context menu near the cursor.
    callback icon-right-clicked(string);

    height: 64px + 2 * Tokens.dock-padding + 2 * Tokens.dock-outer-gap;

    // Locally-resolved colours for the pill (animated on theme change).
    property <color> resolved-bg:     Theme.dock-bg;
    property <color> resolved-border: Theme.dock-border;

    animate resolved-bg     { duration: 200ms; easing: ease-in-out; }
    animate resolved-border { duration: 200ms; easing: ease-in-out; }

    dock-bg := Rectangle {
        x: 0;
        y: Tokens.dock-outer-gap;
        width: parent.width;
        height: 64px + 2 * Tokens.dock-padding;
        background: transparent;

        // Inner pill — outer container is non-clipping so per-icon
        // tooltips can escape upward past the rounded corners. The
        // backdrop+tint are wrapped in a separate `pill-bg` Rectangle
        // that DOES clip, so the blurred wallpaper image (which extends
        // far beyond the pill bounds for the parallax effect) doesn't
        // leak out past the squircle.
        pill := Rectangle {
            x: (parent.width - self.width) / 2;
            y: 0;
            width: items-row.preferred-width + 2 * Tokens.dock-padding;
            height: parent.height;
            background: transparent;
            clip: false;

            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: rgba(0, 0, 0, 0.45);

            // Theme tint + 1px border + top-edge gloss — drawn on top of
            // the GPU real-time blur (which the wgpu pipeline writes to
            // final_tex within this pill's rect BEFORE the overlay pass is
            // composited). No backdrop Image any more — the blur IS the
            // backdrop now, computed per frame from the actual scene
            // behind the pill.
            pill-bg := Rectangle {
                x: 0; y: 0;
                width: parent.width;
                height: parent.height;
                background: root.resolved-bg;
                border-radius: Tokens.dock-corner-radius;
                border-width: 1px;
                border-color: root.resolved-border;
                clip: true;

                // Subtle top-edge gloss highlight (macOS-style).
                Rectangle {
                    x: 0; y: 0;
                    width: parent.width;
                    height: 1px;
                    background: Theme.mode == TokenMode.Dark
                        ? rgba(255, 255, 255, 0.12)
                        : rgba(255, 255, 255, 0.65);
                }
            }

            items-row := HorizontalLayout {
                padding-left: Tokens.dock-padding;
                padding-right: Tokens.dock-padding;
                padding-top: Tokens.dock-padding;
                padding-bottom: Tokens.dock-padding;
                spacing: 0px;
                alignment: center;

                for item[i] in root.items: HorizontalLayout {
                    spacing: 0px;
                    if i > 0 && !item.pinned && root.items[i - 1].pinned:
                    DockSeparator { }

                    DockIconSlot {
                        item: item;
                        icon-clicked(id) => { root.icon-clicked(id); }
                        icon-right-clicked(id, mx, my) => { root.icon-right-clicked(id); }
                    }
                }
            }
        }
    }
}
