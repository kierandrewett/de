// WindowChrome.slint — Server-side decoration chrome for a single toplevel window.
// Renders per WINDOW_SPEC (dark mode / dark-active state as default):
//   - 14 px border-radius outer (circular arc approximation of squircle SDF)
//   - 0.5 px outer border: rgba(0,0,0,0.72)
//   - 1 px inner highlight gradient: rgba(255,255,255,0.08) top → 0 at 2/3 height
//   - Drop shadow: one strong layer (Slint limit); GPU agent adds the other two
//   - Title bar: 33 px, #111318, 0.5 px bottom divider, title text centred Inter SemiBold 13px
//   - Controls: close/min/max right-aligned 21×21px circles with 6px insets
//
// Approximations documented:
//   - border-radius is circular arc not squircle SDF
//   - Only one drop-shadow layer (Slint per-element limit)
//   - 0.5px border approximated as 1px at reduced opacity

import { Tokens } from "./Tokens.slint";
import { IconButton } from "./widgets/IconButton.slint";

export component WindowChrome {
    // ── Properties ────────────────────────────────────────────────────────────
    in property <string> title: "Window";
    in property <bool>   focused: true;
    // The wayland surface texture — fed by Rust each commit.
    in property <image>  content;
    // Animation values from the Rust spring engine.
    // 1.0 = fully visible / full size; 0.0 = invisible / shrunk.
    in property <float>  anim-opacity: 1.0;
    in property <float>  anim-scale:   1.0;
    // Alt-tab ring selection highlight.
    in property <bool>   alt-tab-selected: false;

    // ── Callbacks ─────────────────────────────────────────────────────────────
    callback close-clicked();
    callback minimize-clicked();
    callback maximize-clicked();
    // Fired when the user clicks the titlebar (to activate/raise this window).
    callback title-clicked();

    // ── Geometry — caller positions this component absolutely ─────────────────
    // Minimum sensible size; caller will set width/height from WindowItem geometry.
    min-width:  200px;
    min-height: Tokens.titlebar-height + 100px;

    // Resolved colours based on focus state.
    property <color> resolved-border: focused
        ? Tokens.border-dark-active
        : Tokens.border-dark-inactive;
    property <color> resolved-titlebar-bg: focused
        ? Tokens.titlebar-bg-dark-active
        : Tokens.titlebar-bg-dark-inactive;
    property <color> resolved-titlebar-fg: Tokens.titlebar-fg-dark;
    property <color> resolved-titlebar-border: Tokens.titlebar-border-dark;

    animate resolved-border         { duration: 200ms; easing: ease-in-out; }
    animate resolved-titlebar-bg    { duration: 200ms; easing: ease-in-out; }

    // ── Lifecycle animations (driven by Rust spring engine) ───────────────────
    // The outer-frame opacity and scale are applied here so the entire chrome
    // (titlebar + content + shadow) animates as one unit on open/close/min/max.
    opacity: root.anim-opacity;

    // ── Outer frame with border and shadow ────────────────────────────────────
    // We wrap in a transform Rectangle so the scale spring from the Rust engine
    // can shrink the whole chrome about its centre without moving its x/y anchor.
    transform-wrapper := Rectangle {
        x: root.width * (1.0 - root.anim-scale) / 2;
        y: root.height * (1.0 - root.anim-scale) / 2;
        width: root.width * root.anim-scale;
        height: root.height * root.anim-scale;
        background: transparent;
        clip: false;

    outer-frame := Rectangle {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;

        border-radius: Tokens.window-corner-radius-outer;
        // Approximate 0.5 px border as 1 px at 50% of spec opacity.
        border-width: 1px;
        border-color: root.resolved-border;
        background: transparent;

        // Drop shadow — strongest single layer (GPU agent adds layers 1 and 3).
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: rgba(0, 0, 0, 0.45);

        // ── Title bar ────────────────────────────────────────────────────────
        titlebar := Rectangle {
            x: 0; y: 0;
            width: parent.width;
            height: Tokens.titlebar-height;
            background: root.resolved-titlebar-bg;
            // Top corners follow outer radius; bottom is square (to abut content).
            border-top-left-radius: Tokens.window-corner-radius-outer;
            border-top-right-radius: Tokens.window-corner-radius-outer;
            border-bottom-left-radius: 0px;
            border-bottom-right-radius: 0px;

            // 0.5 px bottom divider (1 px at reduced alpha).
            Rectangle {
                x: 0;
                y: parent.height - 1px;
                width: parent.width;
                height: 1px;
                background: root.resolved-titlebar-border;
                opacity: 0.80;
            }

            // Title text — centred, leaving room for controls on the right.
            Text {
                // Leave 3 × (control + gap) + inset on the right for buttons.
                x: Tokens.titlebar-padding;
                y: 0;
                width: parent.width
                    - Tokens.titlebar-padding
                    - (Tokens.control-size * 3 + Tokens.control-gap * 2 + Tokens.control-inset + 4px);
                height: parent.height;
                text: root.title;
                color: root.resolved-titlebar-fg;
                font-family: Tokens.font-family;
                font-size: Tokens.titlebar-font-size;
                font-weight: 600;   // Semi Bold per WINDOW_SPEC
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;

                animate color { duration: 200ms; easing: ease-in-out; }
            }

            // ── Window controls (right-to-left: minimize, maximize, close) ──
            // Position: 6 px from top, 6 px from right edge.
            controls := Rectangle {
                x: parent.width
                    - (Tokens.control-size * 3 + Tokens.control-gap * 2)
                    - Tokens.control-inset;
                y: Tokens.control-inset;
                width: Tokens.control-size * 3 + Tokens.control-gap * 2;
                height: Tokens.control-size;
                background: transparent;

                // Minimize (leftmost)
                minimize-btn := IconButton {
                    x: 0;
                    y: 0;
                    diameter: Tokens.control-size;
                    bg: rgba(255, 255, 255, 0.08);
                    bg-hover: rgba(255, 255, 255, 0.20);
                    bg-pressed: rgba(255, 255, 255, 0.30);
                    icon-tint: rgba(255, 255, 255, 0.80);
                    clicked => { root.minimize-clicked(); }
                }

                // Maximize (middle)
                maximize-btn := IconButton {
                    x: Tokens.control-size + Tokens.control-gap;
                    y: 0;
                    diameter: Tokens.control-size;
                    bg: rgba(255, 255, 255, 0.08);
                    bg-hover: rgba(255, 255, 255, 0.20);
                    bg-pressed: rgba(255, 255, 255, 0.30);
                    icon-tint: rgba(255, 255, 255, 0.80);
                    clicked => { root.maximize-clicked(); }
                }

                // Close (rightmost)
                close-btn := IconButton {
                    x: (Tokens.control-size + Tokens.control-gap) * 2;
                    y: 0;
                    diameter: Tokens.control-size;
                    bg: rgba(255, 255, 255, 0.08);
                    bg-hover: rgba(200, 60, 60, 0.80);
                    bg-pressed: rgba(180, 40, 40, 0.90);
                    icon-tint: rgba(255, 255, 255, 0.80);
                    clicked => { root.close-clicked(); }
                }
            }
        }

        // ── Client content area ───────────────────────────────────────────────
        content-area := Rectangle {
            x: 0;
            y: Tokens.titlebar-height;
            width: parent.width;
            height: parent.height - Tokens.titlebar-height;
            background: #1d1d1d;
            border-bottom-left-radius: Tokens.window-corner-radius-outer;
            border-bottom-right-radius: Tokens.window-corner-radius-outer;
            clip: true;

            Image {
                width: parent.width;
                height: parent.height;
                source: root.content;
                image-fit: fill;
            }
        }

        // ── Inner highlight overlay (on top of everything) ────────────────────
        // Simulates top-down lighting on glass per WINDOW_SPEC.
        // Rendered as a 1 px inset rectangle with a vertical gradient brush:
        //   top:    rgba(255,255,255,0.08)
        //   bottom: rgba(255,255,255,0.00)
        // The gradient fades to zero at 2/3 of the window height.
        highlight := Rectangle {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            border-radius: Tokens.window-corner-radius-outer - 1px;
            background: transparent;
            // Slint doesn't support per-edge strokes; we use a thin rectangle
            // filled with a gradient as the inset highlight layer.
            // The Rectangle background gradient goes from the highlight colour
            // at the top to fully transparent — we give it only 4 px height so
            // it only touches the very top edge of the frame.
            border-width: 0;

            // Top-edge highlight strip (gradient Rectangle, 2 px tall).
            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: 2px;
                border-top-left-radius: parent.border-radius;
                border-top-right-radius: parent.border-radius;
                background: @linear-gradient(180deg,
                    rgba(255, 255, 255, 0.08) 0%,
                    rgba(255, 255, 255, 0.00) 100%);
            }
        }

        // ── Alt-tab selection outline ─────────────────────────────────────────
        // A bright ring that appears when this window is selected in the
        // alt-tab switcher. Drawn on top of everything.
        if root.alt-tab-selected: Rectangle {
            x: -2px;
            y: -2px;
            width: parent.width + 4px;
            height: parent.height + 4px;
            border-radius: Tokens.window-corner-radius-outer + 2px;
            border-width: 2px;
            border-color: rgba(100, 180, 255, 0.90);
            background: transparent;
        }
    } // end outer-frame

    // ── Titlebar click-to-activate touch area ─────────────────────────────────
    // An invisible TouchArea layered over the titlebar region so clicking
    // anywhere in the titlebar (but not on the control buttons) fires
    // title-clicked → activate-window in Compositor.slint.
    // The control buttons are rendered on top and will eat their own events.
    titlebar-touch := TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: Tokens.titlebar-height;
        // Lower z than control buttons so they take precedence.
        clicked => { root.title-clicked(); }
    }

    } // end transform-wrapper
}
