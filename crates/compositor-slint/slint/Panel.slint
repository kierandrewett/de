// Panel.slint — Top-of-screen shell panel.
// Layout: [Focused App]  [——— Clock ———]  [Network | Audio | Power | CC▼]
// Colours are drawn from Theme global so they animate on light/dark mode switch.
// Height: 34 px.  Full-width, flush to top.
//
// Animation strategy:
//   Locally-resolved colour properties watch Theme.mode and carry 200 ms
//   ease-in-out animate blocks so the panel crossfades on mode change.

import { Tokens, Theme, TokenMode } from "./Tokens.slint";
import { StatusIcon } from "./widgets/StatusIcon.slint";

export component Panel {
    // ── Inbound properties ───────────────────────────────────────────────────
    in property <string> focused-app: "";
    in property <string> clock-text: "00:00";
    in property <image>  icon-network;
    in property <image>  icon-audio;
    in property <image>  icon-power;

    // ── Callbacks ─────────────────────────────────────────────────────────────
    callback toggle-datetime-popout();
    callback toggle-control-centre();

    // ── Geometry ─────────────────────────────────────────────────────────────
    width: 100%;
    height: Tokens.panel-height;

    // ── Locally-resolved colours (animated) ───────────────────────────────────
    property <color> resolved-bg:           Theme.panel-bg;
    property <color> resolved-fg:           Theme.panel-fg;
    property <color> resolved-border:       Theme.panel-border-bottom;
    property <color> resolved-hover-bg: Theme.mode == TokenMode.Dark
        ? rgba(255, 255, 255, 0.08)
        : rgba(0, 0, 0, 0.06);

    animate resolved-bg       { duration: 200ms; easing: ease-in-out; }
    animate resolved-fg       { duration: 200ms; easing: ease-in-out; }
    animate resolved-border   { duration: 200ms; easing: ease-in-out; }
    animate resolved-hover-bg { duration: 200ms; easing: ease-in-out; }

    // Bar background.
    bar := Rectangle {
        width: parent.width;
        height: parent.height;
        background: root.resolved-bg;

        // 0.5 px bottom border.
        bottom-border := Rectangle {
            x: 0;
            y: parent.height - 1px;
            width: parent.width;
            height: 1px;
            background: root.resolved-border;
        }

        // ── Left zone: focused application name ──────────────────────────────
        left-zone := Rectangle {
            x: 0;
            y: 0;
            width: parent.width / 3;
            height: parent.height;

            Text {
                x: 14px;
                y: 0;
                width: parent.width - 14px;
                height: parent.height;
                text: root.focused-app;
                color: root.resolved-fg;
                font-family: Tokens.font-family;
                font-size: Tokens.panel-font-size;
                font-weight: 500;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        // ── Centre zone: clock ───────────────────────────────────────────────
        clock-zone := Rectangle {
            x: (parent.width - self.width) / 2;
            y: 0;
            width: parent.width / 3;
            height: parent.height;

            clock-touch := TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.toggle-datetime-popout(); }
            }

            // Hover highlight.
            Rectangle {
                width: parent.width;
                height: parent.height;
                border-radius: 6px;
                background: clock-touch.has-hover
                    ? root.resolved-hover-bg
                    : transparent;
                animate background { duration: 100ms; easing: ease-out; }
            }

            Text {
                width: parent.width;
                height: parent.height;
                text: root.clock-text;
                color: root.resolved-fg;
                font-family: Tokens.font-family;
                font-size: Tokens.panel-font-size;
                font-weight: 500;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // ── Right zone: status icons + control-centre button ─────────────────
        right-zone := Rectangle {
            x: parent.width - self.width;
            y: 0;
            width: parent.width / 3;
            height: parent.height;

            cc-touch := TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.toggle-control-centre(); }
            }

            // Hover highlight.
            Rectangle {
                width: parent.width;
                height: parent.height;
                border-radius: 6px;
                background: cc-touch.has-hover
                    ? root.resolved-hover-bg
                    : transparent;
                animate background { duration: 100ms; easing: ease-out; }
            }

            // Icons row — right-aligned inside the zone.
            icons-row := Rectangle {
                x: parent.width - self.width - 14px;
                y: (parent.height - self.height) / 2;
                width: 3 * 16px + 2 * 8px;
                height: 16px;

                StatusIcon {
                    x: 0;
                    y: 0;
                    icon: root.icon-network;
                    name: "network";
                    tint: root.resolved-fg;
                }

                StatusIcon {
                    x: 16px + 8px;
                    y: 0;
                    icon: root.icon-audio;
                    name: "audio";
                    tint: root.resolved-fg;
                }

                StatusIcon {
                    x: (16px + 8px) * 2;
                    y: 0;
                    icon: root.icon-power;
                    name: "power";
                    tint: root.resolved-fg;
                }
            }
        }
    }
}
