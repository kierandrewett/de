// Panel.slint — Top-of-screen shell panel.
// Layout: [Focused App]  [— Clock —]  [Network | Audio | Power]
//
// Backdrop: takes a `backdrop` image (pre-blurred wallpaper) which it
// stretches to the full screen size and clips to its own rect, giving the
// bar a glass look without a per-frame GPU pass.

import { Tokens, Theme, TokenMode } from "./Tokens.slint";
import { StatusIcon } from "./widgets/StatusIcon.slint";
import { TrayIconItem } from "./widgets/TrayItem.slint";

export component Panel {
    in property <string> focused-app: "";
    in property <string> clock-text: "00:00";
    /// Short date string shown next to the time (e.g. "Wed 29 Apr").
    in property <string> date-text: "";
    /// Registered StatusNotifierItem icons rendered to the right of the
    /// status icons row. Empty when nothing's registered.
    in property <[TrayIconItem]> tray-items;
    callback tray-clicked(int);
    callback tray-right-clicked(int);
    // Status icons default to phosphor. Filled variants are used where the
    // glyph is small + symbolic (audio, bluetooth, search); outline for the
    // power button (filled was too heavy in the bar) and the wifi/network
    // strength indicators. Rust may override per-state.
    in property <image>  icon-network:   @image-url("../assets/icons/network.svg");
    in property <image>  icon-wifi:      @image-url("../assets/icons/wifi-high.svg");
    in property <image>  icon-audio:     @image-url("../assets/icons/audio.svg");
    in property <image>  icon-power:     @image-url("../assets/icons/power.svg");
    in property <image>  icon-search:    @image-url("../assets/icons/search.svg");
    in property <image>  icon-bluetooth: @image-url("../assets/icons/bluetooth.svg");

    // Glass backdrop — pre-blurred wallpaper stretched to screen size,
    // clipped to bar rect.
    in property <image>  backdrop;
    in property <length> backdrop-screen-w: 1px;
    in property <length> backdrop-screen-h: 1px;

    callback toggle-datetime-popout();
    callback toggle-control-centre();

    width: 100%;
    height: Tokens.panel-height;

    property <color> resolved-bg:           Theme.panel-bg;
    property <color> resolved-fg:           Theme.panel-fg;
    property <color> resolved-border:       Theme.panel-border-bottom;
    property <color> resolved-hover-bg: Theme.mode == TokenMode.Dark
        ? rgba(255, 255, 255, 0.08)
        : rgba(0, 0, 0, 0.06);

    animate resolved-bg       { duration: 200ms; easing: ease-in-out; }
    animate resolved-fg       { duration: 200ms; easing: ease-in-out; }
    animate resolved-border   { duration: 200ms; easing: ease-in-out; }
    animate resolved-hover-bg { duration: 200ms; easing: ease-in-out; }

    bar := Rectangle {
        width: parent.width;
        height: parent.height;
        background: transparent;
        clip: true;

        // Backdrop layer.
        Image {
            x: 0;
            y: 0;
            width: root.backdrop-screen-w;
            height: root.backdrop-screen-h;
            source: root.backdrop;
            image-fit: fill;
        }

        // Theme tint over the backdrop.
        Rectangle {
            width: parent.width;
            height: parent.height;
            background: root.resolved-bg;
        }

        bottom-border := Rectangle {
            x: 0;
            y: parent.height - 1px;
            width: parent.width;
            height: 1px;
            background: root.resolved-border;
        }

        // Focused-app text (left).
        left-zone := Rectangle {
            x: 0; y: 0;
            width: parent.width / 3;
            height: parent.height;

            Text {
                x: 14px; y: 0;
                width: parent.width - 14px;
                height: parent.height;
                text: root.focused-app;
                color: root.resolved-fg;
                font-family: Tokens.font-family;
                font-size: Tokens.panel-font-size;
                font-weight: 500;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        // Clock — centre, button-sized hover. Renders date + time side by
        // side with the date in a slightly muted weight, like macOS.
        clock-zone := Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: row-l.preferred-width + 24px;
            height: parent.height - 8px;

            clock-touch := TouchArea {
                width: parent.width;
                height: parent.height;
                // Open on mouse-DOWN so the popout follows immediately,
                // matching how macOS / GNOME open menus on press. Using
                // `clicked` waits for mouse-up which feels laggy for a
                // peek-style overlay.
                pointer-event(e) => {
                    if (e.button == PointerEventButton.left
                        && e.kind == PointerEventKind.down) {
                        root.toggle-datetime-popout();
                    }
                }
            }

            // Hover bg — fills the clock-zone exactly so there's no visible
            // offset between text and highlight. Sits behind the layout.
            Rectangle {
                x: 0; y: 0;
                width: parent.width;
                height: parent.height;
                border-radius: 6px;
                background: clock-touch.has-hover
                    ? root.resolved-hover-bg
                    : transparent;
                animate background { duration: 100ms; easing: ease-out; }
            }

            // Filling the whole clock-zone with `alignment: center` lets the
            // layout engine centre the date+time pair without having to
            // compute preferred-width manually (which raced and produced
            // the off-centre artefact the user saw).
            row-l := HorizontalLayout {
                x: 0; y: 0;
                width: parent.width;
                height: parent.height;
                spacing: 10px;
                alignment: center;

                if root.date-text != "": Text {
                    text: root.date-text;
                    color: root.resolved-fg;
                    font-family: Tokens.font-family;
                    font-size: Tokens.panel-font-size;
                    font-weight: 500;
                    vertical-alignment: center;
                }
                Text {
                    text: root.clock-text;
                    color: root.resolved-fg;
                    font-family: Tokens.font-family;
                    font-size: Tokens.panel-font-size;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }

        // Status icons — right, sized to the icon row.
        right-zone := Rectangle {
            property <length> icons-w: 3 * 16px + 2 * 8px;
            property <length> zone-padding: 8px;

            x: parent.width - self.width - 8px;
            y: (parent.height - self.height) / 2;
            width: icons-w + zone-padding * 2;
            height: parent.height - 8px;

            cc-touch := TouchArea {
                width: parent.width;
                height: parent.height;
                // Mouse-DOWN — see clock-touch for rationale.
                pointer-event(e) => {
                    if (e.button == PointerEventButton.left
                        && e.kind == PointerEventKind.down) {
                        root.toggle-control-centre();
                    }
                }
            }

            Rectangle {
                width: parent.width;
                height: parent.height;
                border-radius: 6px;
                background: cc-touch.has-hover
                    ? root.resolved-hover-bg
                    : transparent;
                animate background { duration: 100ms; easing: ease-out; }
            }

            icons-row := Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: parent.icons-w;
                height: 16px;

                StatusIcon {
                    x: 0; y: 0;
                    icon: root.icon-network;
                    name: "network";
                    tint: root.resolved-fg;
                }
                StatusIcon {
                    x: 16px + 8px; y: 0;
                    icon: root.icon-audio;
                    name: "audio";
                    tint: root.resolved-fg;
                }
                StatusIcon {
                    x: (16px + 8px) * 2; y: 0;
                    icon: root.icon-power;
                    name: "power";
                    tint: root.resolved-fg;
                }
            }
        }

        // ── Tray icons (StatusNotifierItem) ─────────────────────────────────
        // Sits left of the right-zone control-centre block. Each entry is a
        // hover-highlighted icon with title tooltip; left click → Activate,
        // right click → ContextMenu. `tray-row.preferred-width` makes the
        // panel grow as items register / unregister.
        tray-row := HorizontalLayout {
            x: parent.width - right-zone.width - 8px - self.preferred-width;
            y: (parent.height - 18px) / 2;
            height: 18px;
            spacing: 6px;
            for it in root.tray-items: Rectangle {
                width: 22px;
                height: 22px;
                background: tray-touch.has-hover
                    ? root.resolved-hover-bg
                    : transparent;
                border-radius: 4px;
                animate background { duration: 120ms; easing: ease-out; }
                tray-touch := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    pointer-event(e) => {
                        if (e.button == PointerEventButton.right
                            && e.kind == PointerEventKind.up) {
                            root.tray-right-clicked(it.id);
                        }
                    }
                    clicked => { root.tray-clicked(it.id); }
                }
                Image {
                    x: 3px; y: 3px;
                    width: 16px;
                    height: 16px;
                    source: it.icon;
                    image-fit: contain;
                }
            }
        }
    }
}
